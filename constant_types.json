      "default_attributes": {
        "sensitivity": 4,
        "action": "block",
        "scope": "any"
      },
      "items": [
        {
          "slug": "platform_app_secret",
          "risk": 5,
          "desc": "AppSecret/ClientSecret. Allows full account takeover.",
          "attributes": {
            "sensitivity": 4,
            "action": "block"
          }
        },
        {
          "slug": "platform_session_key",
          "risk": 5,
          "desc": "User Session Key. Used to decrypt PII (Phone/Bio). MUST NOT exist in frontend.",
          "attributes": {
            "sensitivity": 4,
            "action": "block",
            "note": "Critical Privacy Leak"
          }
        },
        {
          "slug": "platform_access_token",
          "risk": 5,
          "desc": "Backend-to-Platform Access Token.",
          "attributes": {
            "sensitivity": 4,
            "action": "block"
          }
        }
      ]
    },
