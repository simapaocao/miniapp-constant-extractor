{
  "version": "1.1",
  "description": "Mini-app constant classification taxonomy for security sensitive information detection. Focuses on secrets, auth, payment, identifiers, PII, endpoints, cloud/storage, crypto config, and noise. Backwards compatible with earlier core groups (url/webhook_url/token/key/ip/path/other_singles).",
  "attribute_defs": [
    {
      "key": "provider",
      "description": "Provider/source system (wechat/tencent/aliyun/aws/stripe/etc.)",
      "data_type": "string"
    },
    {
      "key": "sensitivity",
      "description": "Sensitivity level 1-4 (1=low, 4=very sensitive)",
      "data_type": "integer"
    },
    {
      "key": "action",
      "description": "Policy action (allow|warn|redact|block|rotate_required)",
      "data_type": "string"
    },
    {
      "key": "scope",
      "description": "Where it appears (frontend|backend|any)",
      "data_type": "string"
    },
    {
      "key": "note",
      "description": "Human note",
      "data_type": "string"
    }
  ],
  "risk_scale": {
    "desc": "Severity of risk level",
    "start_index": 200,
    "items": {
      "ignore": "Ignore/noise",
      "low": "Low",
      "medium": "Medium",
      "elevated": "Elevated (Investigation Required)",
      "high": "High (Exploitable)",
      "critical": "Critical (Immediate Breach)"
    }
  },
  "policy_maps": {
    "desc": "Supposed action to take",
    "start_index": 300,
    "risk_to_default_action": {
      "allow": "allow",
      "warn": "warn",
      "redact": "redact",
      "block": "block"
    }
  },
  "token_types": {
    "desc": "Token types used as Credentials, API-key, etc.",
    "start_index": 500,
    "items": {
      "jwt": "jwt token",
      "bearer": "Bearer token",
      "basic": "Basic token",
      "session_key": "WeChat/Alipay Session Key"
    }
  },
  "datatype_categories": [
    {
      "category": "platform_credential",
      "default_risk": 5,
      "desc": "Credentials for platform APIs (e.g., WeChat/Alipay/TikTok)",
